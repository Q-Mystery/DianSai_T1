GPIO5.associatedPins[1].interruptEn       = true;
GPIO5.associatedPins[1].polarity          = "RISE";
GPIO5.associatedPins[1].interruptPriority = "0";

GPIO6.$name                              = "Eight_IR";
GPIO6.associatedPins.create(4);
GPIO6.associatedPins[0].$name            = "AD0";
GPIO6.associatedPins[0].pin.$assign      = "PB16";
GPIO6.associatedPins[1].$name            = "AD1";
GPIO6.associatedPins[1].pin.$assign      = "PB6";
GPIO6.associatedPins[2].$name            = "AD2";
