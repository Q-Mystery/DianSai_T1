GPIO6.associatedPins[3].direction        = "INPUT";
GPIO6.associatedPins[3].internalResistor = "PULL_UP";
GPIO6.associatedPins[3].pin.$assign      = "PB1";

GPIO7.$name                              = "MOTOR_DIR";
GPIO7.associatedPins.create(4);
GPIO7.associatedPins[0].$name            = "AIN1";
GPIO7.associatedPins[0].pin.$assign      = "PB15";
GPIO7.associatedPins[1].$name            = "AIN2";
